{
  "name": "power-and-azure-as-code",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "src/frontend"
  ],
  "scripts": {
    "dev": "npm --workspace @powerandazure/web run dev",
    "build": "npm run build:azure",
    "build:powerapps": "npm --workspace @powerandazure/web run build:powerapps && node scripts/write-version.mjs",
    "build:powerpages": "npm --workspace @powerandazure/web run build:powerpages && node scripts/write-version.mjs",
    "build:azure": "npm --workspace @powerandazure/web run build:azure && node scripts/render-staticwebapp-config.mjs && node scripts/write-version.mjs",
    "validate": "node scripts/validate-config.mjs",
    "version:write": "node scripts/write-version.mjs",
    "rebrand": "node scripts/rebrand.mjs",
    "test:tooling": "node --test scripts/*.test.mjs",
    "test:platform": "node --experimental-strip-types --test src/frontend/src/platform/operations.test.ts"
  },
  "engines": {
    "node": ">=22"
  }
}
