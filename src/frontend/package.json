{
  "name": "@powerandazure/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --mode azure",
    "build:powerapps": "tsc --noEmit -p tsconfig.powerapps.json && vite build --mode powerapps",
    "build:powerpages": "tsc --noEmit -p tsconfig.powerpages.json && vite build --mode powerpages",
    "build:azure": "tsc --noEmit -p tsconfig.azure.json && vite build --mode azure",
    "preview": "vite preview"
  },
  "dependencies": {
    "@microsoft/power-apps": "^1.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@microsoft/power-apps-vite": "^1.0.2",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
